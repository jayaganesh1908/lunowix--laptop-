# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Must match the origin you actually browse on. OAuth redirects and the links
# in transactional email are built from this.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Lunowix

# ---------------------------------------------------------------------------
# Supabase  —  Dashboard → Project Settings → API
# ---------------------------------------------------------------------------
# Safe to expose; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses every RLS policy. Server-side only — never prefix NEXT_PUBLIC_.
# Needed by `npm run seed` and to stamp welcome_email_sent_at.
SUPABASE_SERVICE_ROLE_KEY=

# Sign-in buttons to render, comma separated. Each one must also be enabled in
# Supabase → Authentication → Providers, or clicking it will error.
# Supported here: google, github, discord, gitlab, apple
NEXT_PUBLIC_OAUTH_PROVIDERS=google,github

# ---------------------------------------------------------------------------
# Resend  —  welcome email  (https://resend.com/api-keys)
# ---------------------------------------------------------------------------
# Optional. Without it, sign-in still works and the welcome mail is skipped
# with a console warning.
RESEND_API_KEY=
# Until you verify a domain, Resend only delivers to your own account address.
RESEND_FROM_EMAIL=Lunowix <onboarding@resend.dev>
